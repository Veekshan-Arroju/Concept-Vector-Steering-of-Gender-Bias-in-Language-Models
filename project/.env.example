# Copy to .env and fill in.
SEED=123
MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_TOKEN=
CONCEPT_VECTOR_METHOD=rfm            # rfm | mean_difference
VECTOR_NAME=averaged__misogyny       # default vector for probes / steering scripts
EXPERIMENT=main                      # output namespace; every script also takes --experiment
LANGUAGE=en                          # language pack for dataset_builder (data/languages/<code>/)
FRAME_MODE=random                    # random | fixed  (dataset_builder; or --frame-mode)
FIXED_FRAME_ID=0                     # frame used when FRAME_MODE=fixed
# Optional, for steering_eval.py --judge ...
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JUDGE_MODEL=
